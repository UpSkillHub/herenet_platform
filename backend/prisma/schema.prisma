generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  isAdmin   Boolean  @default(false)
  isMember  Boolean  @default(false)  // Members can post ads/products, normal users can only buy
  status    String   @default("approved")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ads           Ad[]
  payments      Payment[]
  cart          Cart?
  buyerOrders   Order[]   @relation("BuyerOrders")
  sellerOrders  Order[]   @relation("SellerOrders")
  reviews       Review[]
  payoutAccount PayoutAccount?
  payouts       Payout[]
  
  @@index([isMember])
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  ads Ad[]
}

model Ad {
  id          String    @id @default(cuid())
  title       String
  description String
  price       Float
  location    String
  images      String    @default("[]")
  status      String    @default("pending")
  expiryDate  DateTime?
  isFeatured  Boolean   @default(false)
  isPaid      Boolean   @default(false)
  
  // E-commerce fields
  inventory      Int      @default(0)
  lowStockAlert  Int      @default(5)
  variants       Json?    // {types: [{name: "Size", options: ["S","M","L"]}, ...]}
  variantStock   Json?    // {S: 10, M: 5, L: 3}
  shippingFee    Float    @default(0)
  shippingPolicy String?  // free, flat, calculated
  shippingFees   Json?    // {district1: 1000, district2: 1500}
  returnPolicy   String?
  estimatedDays  Int      @default(3) // Delivery time
  avgRating      Float    @default(0)
  reviewCount    Int      @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId     String
  categoryId String

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
  payments   Payment[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  
  @@index([status])
  @@index([inventory])
  @@index([avgRating])
}

model Payment {
  id                   String   @id @default(cuid())
  transactionId        String?  @unique
  transactionRef       String?  @unique
  currency             String?
  method               String?
  flutterwaveReference String?
  amount               Float
  days                 Int
  isFeatured           Boolean  @default(false)
  paymentStatus        String   @default("pending")
  createdAt            DateTime @default(now())

  userId String
  adId   String?

  user User @relation(fields: [userId], references: [id])
  ad   Ad?  @relation(fields: [adId], references: [id])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  variant   String?  @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Ad   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variant])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                String    @id @default(cuid())
  orderNumber       String    @unique
  buyerId           String
  sellerId          String
  status            String    @default("pending")
  paymentStatus     String    @default("pending")
  subtotal          Float
  shippingFee       Float     @default(0)
  serviceFee        Float
  commission        Float
  total             Float
  paymentMethod     String?
  transactionId     String?
  escrowStatus      String    @default("pending")
  escrowReleaseDate DateTime?
  shippingAddress   Json
  trackingNumber    String?
  trackingCarrier   String?
  estimatedDelivery DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  buyer         User                 @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller        User                 @relation("SellerOrders", fields: [sellerId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reviews       Review[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  price       Float
  quantity    Int
  variant     Json?
  subtotal    Float
  createdAt   DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Ad    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  notes     String?
  createdBy String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  orderId    String
  buyerId    String
  rating     Int
  title      String
  content    String
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Ad    @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order @relation(fields: [orderId], references: [id])
  buyer   User  @relation(fields: [buyerId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@index([buyerId])
  @@index([rating])
}

model PayoutAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  payoutMethod    String   // mobile_money, bank_transfer
  mobileProvider  String?  // MTN, Airtel
  mobileNumber    String?
  bankName        String?
  accountNumber   String?
  accountHolder   String?
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payout {
  id            String    @id @default(cuid())
  sellerId      String
  amount        Float
  commission    Float
  netAmount     Float
  status        String    @default("pending") // pending, processing, completed, failed
  paymentMethod String
  transactionId String?
  orderIds      Json      // Array of order IDs included in payout
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  seller User @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}
