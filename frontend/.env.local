# frontend/.env.local
# ============================================================
#  frontend/.env.local
#  Only NEXT_PUBLIC_ vars are exposed to the browser.
#  Never put secret keys with NEXT_PUBLIC_ prefix.
# ============================================================

# ── API ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── SITE ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── FLUTTERWAVE (public key only — safe for browser) ─────────
# Demo key for testing (replace with your actual key)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-bbdd54eb362a8909da5ef730057de107-X
# ── OPTIONAL: Google OAuth ────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id